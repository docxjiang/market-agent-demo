# OpenAI-compatible LLM configuration.
# Copy this file to .env and fill in one API key before running the app.

OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-v4-flash

# Use either OPENAI_API_KEY or DEEPSEEK_API_KEY.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# Set to 1 to let command-line report generation refine the rule-based report with an LLM.
USE_LLM_REFINER=0

LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.2
